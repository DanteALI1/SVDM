# SVDB environment example
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

POSTGRES_DB=svdb
POSTGRES_USER=svdb
POSTGRES_PASSWORD=svdb
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://svdb:svdb@db:5432/svdb
REDIS_URL=redis://redis:6379/0

SVDB_PLATFORM_USER=platform
SVDB_PLATFORM_PASSWORD=SecurePass1!
SVDB_TENANT_NAME=Default
SVDB_TENANT_SLUG=default
SVDB_TENANT_USER=admin
SVDB_TENANT_PASSWORD=SecurePass1!
SVDB_BOOTSTRAP=1

SESSION_IDLE_MINUTES=60
AUDIT_RETENTION_DAYS=180
